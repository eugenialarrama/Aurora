@page
@model Aurora.Pages.PageTipoEquipamiento.EliminarModel
@{
    ViewData["Title"] = "Eliminar tipo de equipamiento";
}
<div class="text left">
    <h1 class="display-4 text-center">Eliminar Tipo de Equipamiento</h1>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.tipo.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipo.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.tipo.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipo.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.tipo.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipo.Descripcion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.tipo.Caracteristicas)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipo.Caracteristicas)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.tipo.PrecioAlquiler)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipo.PrecioAlquiler)
        </dd>
        <dt class="col-sm-2">
            Depósito
        </dt>
        <dd class="col-sm-10">
            @Model.tipo.Deposito.Nombre
        </dd>
    </dl>
    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.tipo.Id" />
        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Eliminar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
