@page
@model Aurora.Pages.PageUnidadEquipamiento.EliminarModel
@{
    ViewData["Title"] = "Eliminar Unidad de Equipamiento"; 
}
<div class="text left">
    <h1 class="display-4 text-center">Eliminar Unidad de Equipamiento</h1>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.unidad.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.unidad.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.unidad.Identificador)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.unidad.Identificador)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.unidad.Estado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.unidad.Estado)
        </dd>
        <dt class="col-sm-2">
            Tipo
        </dt>
        <dd class="col-sm-10">
            @Model.unidad.Tipo.Nombre
        </dd>
        <dt class="col-sm-2">
            Depósito
        </dt>
        <dd class="col-sm-10">
            @Model.unidad.Deposito.Nombre
        </dd>
    </dl>
    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.unidad.Id" />
        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Eliminar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
</div>
