@page
@model Aurora.Pages.PageUnidadEquipamiento.ModificarModel
@{
    ViewData["Title"] = "Modificar unidad de equipamiento";
}
<div class="text-left">
    <h1 class="display-4 text-center">Modificar una Unidad de Equipamiento</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" value="@Model.unidad.Id" readonly />
                </div>
                <div class="form-group">
                    <label for="identificador">Identificador:</label>
                    <input class="form-control" type="text" name="identificador" id="identificador" value="@Model.unidad.Identificador" />
                </div>
                <div class="form-group">
                    <label for="estado">Estado:</label>
                    <select class="form-control" name="estado" id="estado">
                        @foreach (string unEstado in Model.Estados)
                        {
                            if (unEstado == Model.unidad.Estado)
                            {
                                <option value="@unEstado" selected>@unEstado</option>
                            }
                            else
                            {
                                <option value="@unEstado">@unEstado</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="idTipo">Tipo de Equipamiento:</label>
                    <select class="form-control" name="idTipo" id="idTipo">
                        @foreach (Dominio.TipoEquipamiento unTipo in Model.Tipos)
                        {
                            if (unTipo.Id == Model.unidad.Tipo.Id)
                            {
                                <option value="@unTipo.Id" selected>@unTipo.Nombre</option>
                            }
                            else
                            {
                                <option value="@unTipo.Id">@unTipo.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="idDeposito">Depósito:</label>
                    <select class="form-control" name="idDeposito" id="idDeposito">
                        @foreach (Dominio.Deposito unDeposito in Model.Depositos)
                        {
                            if (unDeposito.Id == Model.unidad.Deposito.Id)
                            {
                                <option value="@unDeposito.Id" selected>@unDeposito.Nombre</option>
                            }
                            else
                            {
                                <option value="@unDeposito.Id">@unDeposito.Nombre</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Modificar">Modificar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>