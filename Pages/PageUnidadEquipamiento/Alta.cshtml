@page
@model Aurora.Pages.PageUnidadEquipamiento.AltaModel
@{
    ViewData["Title"] = "Alta de unidad de equipamiento";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar una Unidad de Equipamiento</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" />
                </div>
                <div class="form-group">
                    <label for="identificador">Identificador (número de serie o código):</label>
                    <input class="form-control" type="text" name="identificador" id="identificador" />
                </div>
                <div class="form-group">
                    <label for="idTipo">Tipo de Equipamiento:</label>
                    <select class="form-control" name="idTipo" id="idTipo">
                        <option value="">Seleccione un Tipo</option>
                        @foreach (Dominio.TipoEquipamiento unTipo in Model.Tipos)
                        {
                            <option value="@unTipo.Id">@unTipo.Nombre</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="idDeposito">Depósito:</label>
                    <select class="form-control" name="idDeposito" id="idDeposito">
                        <option value="">Seleccione un Depósito</option>
                        @foreach (Dominio.Deposito unDeposito in Model.Depositos)
                        {
                            <option value="@unDeposito.Id">@unDeposito.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
