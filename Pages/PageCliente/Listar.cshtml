@page
@model Aurora.Pages.PageCliente.ListarModel
@{
    ViewData["Title"] = "Listado de Clientes";
}
<div>
    <h1 class="display-4">Listado de Clientes</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Agregar cliente</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
                <th>Activo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Clientes != null && Model.Clientes.Any())
            {
                @foreach (Dominio.Cliente unCli in Model.Clientes)
                {
                    <tr>
                        <td>@unCli.Id</td>
                        <td>@unCli.Tipo</td>
                        <td>@unCli.Nombre</td>
                        <td>@unCli.Documento</td>
                        <td>@unCli.Telefono</td>
                        <td>@unCli.Email</td>
                        <td>@unCli.Direccion</td>
                        @if (unCli.Activo)
                        {
                            <td>Sí</td>
                        }
                        else
                        {
                            <td>No</td>
                        }
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@unCli.Id">Modificar</a>
                                <a class="btn btn-danger" asp-page="./Desactivar" asp-route-id="@unCli.Id">Desactivar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">
                        No hay clientes ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
