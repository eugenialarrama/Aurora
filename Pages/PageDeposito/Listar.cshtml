@page
@model Aurora.Pages.PageDeposito.ListarModel
@{
    ViewData["Title"] = "Listado de depósitos";
}
<div>
    <h1 class="display-4 text-center">Listado de depósitos</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./Alta">Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Dirección</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Depositos != null && Model.Depositos.Any())
            {
                @foreach (Dominio.Deposito unDep in Model.Depositos)
                {
                    <tr>
                        <td>@unDep.Id</td>
                        <td>@unDep.Nombre</td>
                        <td>@unDep.Direccion</td>
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./Modificar" asp-route-id="@unDep.Id">Modificar</a>
                                <a class="btn btn-danger" asp-page="./Eliminar" asp-route-id="@unDep.Id">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No hay Depósitos ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
